# Biomni Bridge runtime configuration.
#
# LOCAL PYTHON:
#   cp .env.example .env
#   edit .env
#   set -a; source .env; set +a
#   biomni-bridge
#
# Docker Compose reads .env automatically for ${...} substitutions.
# The container always uses /data and /output internally; docker-compose.yml
# maps ./data -> /data and ./output -> /output.
#
BIOMNI_CUSTOM_BASE_URL=
BIOMNI_CUSTOM_API_KEY=

# Credential behavior: auto (default), ui, or env.
# auto = use env credentials when both exist, otherwise require UI credentials.
# ui   = ignore any API key from the environment and require per-session UI input.
# env  = require both environment credentials at startup and disable UI input.
BIOMNI_CREDENTIAL_MODE=auto

# UI endpoint hardening. Keep true unless you explicitly trust users and need
# private/internal model endpoints. UI URLs must otherwise be public HTTPS.
BIOMNI_UI_PUBLIC_ENDPOINTS_ONLY=true
# Optional exact hostname allowlist, e.g. models.example.org,other.example.org
BIOMNI_ALLOWED_API_HOSTS=
# Release inactive in-memory session adapters/credential references.
BIOMNI_SESSION_TTL_SECONDS=3600

# Optional. Leave empty to select the first model returned by GET /models.
BIOMNI_MODEL=
# Optional fallback when the endpoint does not expose GET /models.
BIOMNI_MODELS=

# Native/local Python paths. These are intentionally NOT passed through by
# docker-compose.yml; Docker uses its fixed /data and /output mount points.
BIOMNI_DATA_PATH=./data
BIOMNI_OUTPUT_PATH=./output

# Native/local Gradio bind settings. Docker ignores these and uses its own
# container bind address/port from the Dockerfile.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# The large Biomni data directory should be mounted at /data.
BIOMNI_SKIP_DATA_DOWNLOAD=true
BIOMNI_TIMEOUT_SECONDS=1200
BIOMNI_TEMPERATURE=0.7
BIOMNI_USE_TOOL_RETRIEVER=true
BIOMNI_COMMERCIAL_MODE=false
BIOMNI_DISCOVER_MODELS=true

# Optional diagnostic. Writes the provider request body (without auth fields)
# under BIOMNI_OUTPUT_PATH/llm-debug. The file contains the real prompt/task.
BIOMNI_DEBUG_LLM_REQUESTS=false

# Provider compatibility controls.
BIOMNI_LLM_STREAM_TRANSPORT=true
BIOMNI_QWEN_DISABLE_THINKING=true
